{
    "name": "wallabag/wallabin",
    "description": "Binary for installing and updating wallabag",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "symfony/console": "^6.4",
        "symfony/process": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Wallabag\\Wallabin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wallabag\\Wallabin\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/wallabin"],
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    }
}
